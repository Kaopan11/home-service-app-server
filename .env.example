# Copy to .env — Spring loads this file on local startup.
# Do not commit .env. Render/Vercel env vars still win in production.

# PORT=8080

# # Direct db host (legacy):
# # jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# # Username may be postgres
# #
# # Pooler (preferred):
# # jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# # Username is often postgres.<project-ref> not postgres.
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
# SPRING_DATASOURCE_PASSWORD=your-database-password
# # Use none in shared/prod-like envs. Local-only may use update.
# SPRING_JPA_HIBERNATE_DDL_AUTO=none

# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://your-frontend.vercel.app

# # Project Settings → API
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# # Omise Dashboard → Settings → Keys
# # Secret key must never be exposed to the client.
# OMISE_PUBLIC_KEY=pkey_test_your-omise-public-key
# OMISE_SECRET_KEY=skey_test_your-omise-secret-key


